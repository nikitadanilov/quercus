all: test

build: config all $(INC_DIR)/quercus.hpp

test-suite: 
	make APP_NAME=$(APP_NAME) $(APP_NAME)

menuconfig:
	$(ETC_DIR)/dialog-configure dialog `which dialog` $(INC_DIR)/config.h.in $(INC_DIR)/config.h

kconfig:
	$(ETC_DIR)/dialog-configure kdialog `which kdialog` $(INC_DIR)/config.h.in $(INC_DIR)/config.h

test : objs

objs : $(OBJ) $(OBJ_DIR)/test.o
	$(CPP) $(LDFLAGS) -o $(APP_NAME) $(OBJ) $(OBJ_DIR)/test.o $(LIBS) $(CPP_FILTER)

shared : $(SHLIB) $(OBJ_DIR)/test.o
	$(CPP) $(LDFLAGS) -o $(APP_NAME) $(SHLIB) $(OBJ_DIR)/test.o $(LIBS) $(CPP_FILTER)

clean:
	for dir in `find . -type d -exec echo {} \;` ;do ( cd $$dir ; rm -f $(JUNK_FILES) ; rm -fr $(JUNK_DIRS) ) ;done

config:
	rm -f $(BUILD_INFO_FILE)
	echo $$((`cat $(BUILD_TAG_FILE)`+1)) > $(BUILD_TAG_FILE)
	echo '/* -*- C++ -*- Automatically generated. Do not edit. */' >> $(BUILD_INFO_FILE)
	echo '#define BUILD_DATE "$(DATE)"' >> $(BUILD_INFO_FILE)
	echo '#define BUILD_HOST "$(HOST)"' >> $(BUILD_INFO_FILE)
	echo '#define BUILDER    "$(USR)"'  >> $(BUILD_INFO_FILE)
	echo '#define BUILD      ' $(shell cat $(BUILD_TAG_FILE))  >> $(BUILD_INFO_FILE)
	echo >> $(BUILD_INFO_FILE)
	echo '#define MAJOR_VERSION ' $(MAJOR_VERSION)  >> $(BUILD_INFO_FILE)
	echo '#define MINOR_VERSION ' $(MINOR_VERSION)  >> $(BUILD_INFO_FILE)
	echo '#define MICRO_VERSION ' $(MICRO_VERSION)  >> $(BUILD_INFO_FILE)
	echo '#define QR_CODENAME "$(QR_CODENAME)"'  >> $(BUILD_INFO_FILE)

check-files:
	@ls $(INC) $(SRC) > /dev/null

$(LIB_DIR)/libquercus.a: $(OBJ)
	rm -f $@
	ar -qsv $@ $(OBJ)

$(LIB_DIR)/quercus.o:
	$(CPP) $(CFLAGS) $(INCS) -I$(SRC_DIR) $(DEFINES) $(SRC_DIR)/all-in-one.cpp -c -o $@ $(CPP_FILTER)

#this becomes a bit tricky once we store .o files in separate tree
# makedepend -Y $(INCS) $(SRC) -f- | sed -e 's/^\.\/src/\.\/obj/g' >> Makefile.stripped
depend:
	echo "s,^$(SRC_DIR),$(OBJ_DIR),g" | sed 's/\//\\\//g' | sed 's/\./\\\./g' | sed 's/,/\//g' > .pattern
	head -n `egrep -n '^#MAKEDEPEND' Makefile | cut -d ":" -f 1` Makefile > Makefile.stripped
	makedepend -w8000 -Y $(INCS) $(SRC) $(SRC_DIR)/test.cpp -f- | sed -f .pattern >> Makefile.stripped
	mv Makefile.stripped Makefile
	rm -f .pattern

tags:
	$(ETAGS) -l c++ -C -o TAGS $(SRC) $(INC)

archive: 
	LANG=C ; tar cf - $(SRC_DIR) $(INC_DIR) $(DOC_DIR) $(ETC_DIR) Makefile .build | gzip -9c > $$HOME/archive/quercus-`date "+%Y-%m-%d-%H-%M"`.tar.gz

check-distr:
	@for f in $(ALL_DISTR_FILES) ;do if test ! -r $$f ;then echo $$f missing. ;fi ;done

cronbuild: clean makedirs depend tags archive build libs all-in-one-shared #api-docs 

touch:
	find . | xargs touch

makedirs:
	for type in $(SRC_DIR) $(INC_DIR) $(OBJ_DIR) $(LIB_DIR) $(DOC_DIR) ;do for package in $(PACKAGES) ;do mkdir -p $$type/$$package;	done ; done

links:
	-cd all ; for package in $(PACKAGES) ;do for dir in $(SRC_DIR) $(INC_DIR) ;do FILE=../$$dir/$$package/*.?pp ; ls $$FILE >/dev/null 2>/dev/null ; if [ $$? -eq 0 ] ;then ln -s $$FILE . 2>/dev/null ;fi ;done ;done

pkg:
	TOP=`pwd` ; \
	for p in $(PACKAGES) \
		;do \
			mkdir -p pkg/$$p ; \
			FILES=`find $$TOP/$(INC_DIR)/$$p $$TOP/$(SRC_DIR)/$$p $$TOP/$(OBJ_DIR)/$$p -type f -maxdepth 1` ; \
			if test -n "$$FILES" \
				;then \
					ln -s $$FILES pkg/$$p \
				;fi \
		;done

prof-out:
	gprof -tCgxz $(APP_NAME) > prof.out #	gprof -tCgxz $(APP_NAME) > prof.out
	gprof -x -l -A $(APP_NAME) > lines.counts
	gprof -tCgxz -A $(APP_NAME) > profiled.source

add-all-to-CVS:
	for i in `find . -name \*pp` ;do \
	( d=`dirname $$i` ; cd `dirname $$d` ; cvs add `basename $$d` ) ; \
	( cd `dirname $$i` ; cvs add `basename $$i` ) ;done

api-docs:
	cd tmp ; mkdir -p `(cd .. ; find inc -type d )`
	for i in `find $(INC_DIR) -type f -name '*[hp]'` ;do cat $$i | sed 's/^interface/class/g' > tmp/$$i ; echo $$i ;done ; 
	rm -fr $(DOC_DIR)/api
	mkdir $(DOC_DIR)/api
	rm tmp/$(INC_DIR)/quercus*
	cd tmp ; doc++ -H -d ../$(DOC_DIR)/api/ $(INC_DIR) ; 
	cd tmp ; doc++ -t -o ../$(DOC_DIR)/api/api.tex $(INC_DIR)

htmlize:
	for i in `find $(INC_DIR) -name '*.?pp'` ;do gnudoit "(htmlize-file \"`pwd`/$$i\" \"`pwd`/$(DOC_DIR)/html/$(INC_DIR)\")" ; echo $$i done. ;done
	for s in `find $(SRC_DIR) -name '*.?pp'` ;do gnudoit "(htmlize-file \"`pwd`/$$s\" \"`pwd`/$(DOC_DIR)/html/$(SRC_DIR)\")" ; echo $$s done. ;done

